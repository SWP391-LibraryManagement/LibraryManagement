# .agentignore — Hệ thống Quản lý Thư viện
# Công cụ AI/agent phải bỏ qua các mẫu dưới đây khi quét, lập chỉ mục
# hoặc chỉnh sửa kho mã nguồn. Ngữ nghĩa tương tự các file ignore thông dụng.

# Đầu ra build
target/
dist/
build/
out/
bin/
obj/

# Phần phụ thuộc
node_modules/
vendor/

# IDE / trình soạn thảo
.idea/
.vscode/

# File phụ của hệ điều hành
.DS_Store
Thumbs.db

# Bí mật và biến môi trường
.env
.env.*
*.secret
secrets/
credentials/

# Nhật ký
*.log

# Vùng tạm cục bộ của agent
_commit_msg.txt
